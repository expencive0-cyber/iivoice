{
  "manifest_version": 3,
  "name": "DHL Invoice Assist",
  "version": "1.4.2",
  "description": "DHL Invoice Assist: local invoice organization, optional ETA matching, master PDF, customer ZIP and five languages.",
  "action": {
    "default_title": "Open DHL Invoice Assist",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'; worker-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
